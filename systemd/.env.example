# PumpDotFun Environment Configuration
# Copy this file to /opt/pumpdotfun/.env and modify as needed

# Database Configuration
DATABASE_URL=postgresql://pumpdotfun:password@localhost/pumpdotfun

# Redis Configuration
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# WebSocket Configuration
WSS_PORT=8080
WSS_HOST=0.0.0.0

# Logging Configuration
RUST_LOG=info
RUST_BACKTRACE=1

# Core Service Configuration (if needed)
# Add any specific environment variables your core service needs

# Security (if using HTTPS)
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem
