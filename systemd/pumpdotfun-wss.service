[Unit]
Description=PumpDotFun WebSocket Service
After=network.target redis.service pumpdotfun-core.service
Wants=network.target
Requires=redis.service

[Service]
Type=simple
User=pumpdotfun
Group=pumpdotfun
WorkingDirectory=/opt/pumpdotfun/wss
ExecStart=/usr/bin/env cargo run
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pumpdotfun-wss

# Environment variables
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=REDIS_URL=redis://localhost:6379
Environment=WSS_PORT=8080

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pumpdotfun

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
