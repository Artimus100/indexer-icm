[Unit]
Description=PumpDotFun API Service
After=network.target postgresql.service pumpdotfun-core.service
Wants=network.target
Requires=postgresql.service

[Service]
Type=simple
User=pumpdotfun
Group=pumpdotfun
WorkingDirectory=/opt/pumpdotfun/api
ExecStart=/usr/bin/env cargo run
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pumpdotfun-api

# Environment variables
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=DATABASE_URL=postgresql://pumpdotfun:password@localhost/pumpdotfun
Environment=API_PORT=3000

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pumpdotfun

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
