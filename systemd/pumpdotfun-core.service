[Unit]
Description=PumpDotFun Core Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=pumpdotfun
Group=pumpdotfun
WorkingDirectory=/opt/pumpdotfun
ExecStart=/usr/bin/env RUST_LOG=info cargo run --bin core -- --config "./core/Vixen.toml"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pumpdotfun-core

# Environment variables
Environment=RUST_BACKTRACE=1

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pumpdotfun

# Resource limits
LimitNOFILE=65536
MemoryMax=2G

[Install]
WantedBy=multi-user.target
